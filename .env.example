# --- Majburiy ---
BOT_TOKEN=bu_yerga_bot_tokeningizni_yozing

# --- Ixtiyoriy sozlamalar ---
# Instagram/YouTube cookie'lari: auto | chrome | edge | firefox
# 'auto' - avval cookie'siz urinadi, bloklansa brauzerlardan cookie oladi
# Serverda cookie'lar (brauzer yo'q joyda). cookies.txt ni base64 ga o'girib qo'ying.
# Faqat yosh cheklovi/login talab qilinadigan videolar uchun kerak.
COOKIES_B64=

COOKIES_FROM_BROWSER=

# Video sifati va hajmi
MAX_VIDEO_HEIGHT=720
MAX_UPLOAD_MB=48

# Qo'shiq qidirish aniqligi (bo'lak uzunligi va urinishlar soni)
CLIP_SECONDS=12
MAX_ATTEMPTS=5

# Vaqtinchalik fayllar umri (soniya) va parallel yuklashlar soni
FILE_TTL_SECONDS=7200
MAX_CONCURRENT_DOWNLOADS=3

# Bitta yuklashga ajratilgan vaqt (soniya) va videoning maksimal uzunligi (daqiqa)
DOWNLOAD_TIMEOUT=300
MAX_DURATION_MIN=30

# Shazam'ga bir vaqtda yuboriladigan so'rovlar soni
MAX_CONCURRENT_RECOGNITIONS=2

# --- Ixtiyoriy: ACRCloud zaxira xizmati ---
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# ----------------------------------------------------------------------------
# XAVFSIZLIK
# ----------------------------------------------------------------------------
# Bo'sh bo'lsa - bot hamma uchun ochiq.
# Yopiq rejim uchun Telegram ID'laringizni vergul bilan yozing: 123456,7891011
ALLOWED_USERS=

# Bot egasi(lari) - cheklovlarsiz ishlaydi va yopiq rejimda ham kira oladi
ADMIN_USERS=

# Spamga qarshi: bitta foydalanuvchi uchun soatlik limit va pauza (soniya)
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_COOLDOWN=5

# Vaqtinchalik fayllar egallashi mumkin bo'lgan eng katta joy (MB)
MAX_DISK_MB=2048

# Bitta videoni diskka yuklashning eng katta hajmi (MB)
MAX_FILESIZE_MB=200
